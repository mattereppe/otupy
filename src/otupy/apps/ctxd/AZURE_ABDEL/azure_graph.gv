digraph azure_graph {
	graph [rankdir=LR]
	azure [label="Azure Cloud"]
	"test-vm" [label="test-vm" fontcolor=black]
	azure -> "test-vm" [label=control color=black dir=forward fontcolor=black]
	"test-vm-nsg" [label="test-vm-nsg" fontcolor=black]
	azure -> "test-vm-nsg" [label=protect color=black dir=forward fontcolor=black]
	azrstoragetest [label=azrstoragetest fontcolor=black]
	azure -> azrstoragetest [label=hosting color=black dir=forward fontcolor=black]
}
